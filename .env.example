# Copy to .env before `docker compose up`. Compose passes these into the ui and
# runner containers, where competition.config.yaml reads them.
#
# Every variable here is required. competition.config.yaml refers to each one as
# ${{ env("...") }}, and a missing variable fails the whole config rather than
# just the feature that needs it — the services start and then answer nothing.

# Who can reach /dashboard, matched against the signed-in user's email. Leave the
# list empty and nobody can: the dashboard fails closed.
ADMIN_EMAIL=you@example.com

# The GitHub organisation submissions are forked into, and a PAT that can do it.
GITHUB_ORG=your-org
GITHUB_PAT=github_pat_...

# An OAuth app, for signing in with GitHub.
# https://github.com/settings/developers — the callback URL is
# <BASE_URL>/api/auth/callback/github, e.g. http://localhost:3007/api/auth/callback/github
GITHUB_CLIENT_ID=Iv1....
GITHUB_CLIENT_SECRET=...
